if GRUB2_SECONDARY_PAYLOAD

choice
	prompt "GRUB2 version"
	default GRUB2_SECONDARY_STABLE

config GRUB2_SECONDARY_STABLE
	bool "2.02"
	help
	  Stable GRUB2 version

config GRUB2_SECONDARY_MASTER
	bool "HEAD"
	help
	  Newest GRUB2 version

config GRUB2_SECONDARY_REVISION
	bool "git revision"
	help
	  Select this option if you have a specific commit or branch
	  that you want to use as the revision from which to
	  build GRUB2.

	  You will be able to specify the name of a branch or a commit id
	  later.
endchoice

config GRUB2_FLOPPY
	bool "Add GRUB2 as a SeaBIOS Floppy image"
	depends on PAYLOAD_SEABIOS
	default y

source "payloads/external/GRUB2/Kconfig.common"

endif
