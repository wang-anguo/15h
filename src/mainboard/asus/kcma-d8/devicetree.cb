chip northbridge/amd/agesa/family15/root_complex	# Root complex
	device cpu_cluster 0 on			# (L)APIC cluster
		chip cpu/amd/agesa/family15			# CPU socket
			device lapic 0x20 on end			# Local APIC of the CPU
		end
	end
	device domain 0 on			# PCI domain
		subsystemid 0x1043 0x8163 inherit
		chip northbridge/amd/agesa/family15		# Northbridge / RAM controller
			device pci 18.0 on
				chip northbridge/amd/cimx/rd890		# Primary southbridge
					device pci 0.0 on end			# HT Root Complex 0x9600
					device pci 0.1 off end			# CLKCONFIG
					device pci 0.2 on end			# IOMMU
					device pci 2.0 on end			# PCIE P2P bridge 0x9603 (GPP1 Port0), PCIe1 / PCIe2
					device pci 3.0 off end			# PCIE P2P bridge 0x960b (GPP1 Port1)
					device pci 4.0 on end			# PCIE P2P bridge 0x9604 (GPP3a Port0), PIKE SAS
					device pci 5.0 off end			# PCIE P2P bridge 0x9605 (GPP3a Port1)
					device pci 6.0 off end			# PCIE P2P bridge 0x9606 (GPP3a Port2)
					device pci 7.0 off end			# PCIE P2P bridge 0x9607 (GPP3a Port3)
					device pci 8.0 off end			# NB/SB Link P2P bridge
					device pci 9.0 on end			# Bridge (GPP3a Port4), NIC A
					device pci a.0 on end			# Bridge (GPP3a Port5), NIC b
					device pci b.0 on end			# Bridge (GPP2 Port0), PCIe4
					register "index" = "0"                  # Northbridge Number
					register "gpp1_configuration" = "0"	# Configuration 16:0 default
					register "gpp2_configuration" = "1"	# Configuration 8:8
					register "gpp3a_configuration" = "2"	# Configuration 4:1:1:0:0:0
					register "port_enable" = "0x0e14"	# 0b111000010100
				end
				chip southbridge/amd/cimx/sb700		# Secondary southbridge
					device pci 11.0 on end			# SATA
					device pci 12.0 on end			# USB
					device pci 12.1 on end			# USB
					device pci 12.2 on end			# USB
					device pci 13.0 on end			# USB
					device pci 13.1 on end			# USB
					device pci 13.2 on end			# USB
					device pci 14.0 on			# SM
						chip drivers/generic/generic	# DIMM n-0-0-0
							device i2c 50 on end
						end
						chip drivers/generic/generic	# DIMM n-0-0-1
							device i2c 51 on end
						end
						chip drivers/generic/generic	# DIMM n-0-1-0
							device i2c 52 on end
						end
						chip drivers/generic/generic	# DIMM n-0-1-1
							device i2c 53 on end
						end
						chip drivers/generic/generic	# DIMM n-1-0-0
							device i2c 54 on end
						end
						chip drivers/generic/generic	# DIMM n-1-0-1
							device i2c 55 on end
						end
						chip drivers/generic/generic	# DIMM n-1-1-0
							device i2c 56 on end
						end
						chip drivers/generic/generic	# DIMM n-1-1-1
							device i2c 57 on end
						end
					end
					device pci 14.1 on end			# IDE 0x439c
					device pci 14.2 on end			# HDA 0x4383 (ASUS MIO add-on card)
					device pci 14.3 on			# LPC 0x439d (SMBUS primary controller)
						chip superio/winbond/w83667hg-a	# Super I/O
							device pnp 2e.0 off end		# FDC; Not available on the KCMA-D8
							device pnp 2e.1 off end		# LPT1; Not available on the KCMA-D8
							device pnp 2e.2 on		# COM1
								io 0x60 = 0x3f8
								irq 0x70 = 4
							end
							device pnp 2e.3 on		# COM2
								io 0x60 = 0x2f8
								irq 0x70 = 3
							end
							device pnp 2e.5 on		# PS/2 keyboard & mouse
								io 0x60 = 0x60
								io 0x62 = 0x64
								irq 0x70 = 1
								irq 0x72 = 12
							end
							device pnp 2e.106 off end	# SPI: Not available on the KCMA-D8
							device pnp 2e.107 off end	# GIPO6
							device pnp 2e.207 off end	# GIPO7
							device pnp 2e.307 off end	# GIPO8
							device pnp 2e.407 off end	# GIPO9
							device pnp 2e.8 off end		# WDT
							device pnp 2e.108 off end	# GPIO 1
							device pnp 2e.9 off end		# GPIO2
							device pnp 2e.109 off end	# GPIO3
							device pnp 2e.209 off end	# GPIO4
							device pnp 2e.309 off end	# GPIO5
							device pnp 2e.a off end		# ACPI
							device pnp 2e.b off		# HW Monitor
								io 0x60 = 0x290
								# IRQ purposefully not assigned to prevent lockups
							end
							device pnp 2e.c off end		# PECI
							device pnp 2e.d off end		# VID_BUSSEL
							device pnp 2e.f off end		# GPIO_PP_OD
						end
						chip drivers/i2c/w83795
							# Enable Digital Temperature Sensors
							register "dtse" = "0x03"			# DTS1-2 (Sockets 1-2)
							# Enable Voltage Sensors
							register "volt_ctrl1" = "0xFF"			# VSEN1 - VSEN8
							register "volt_ctrl2" = "0x7F"			# VSEN9-11, VTT, 3VDD, 3VSB, VBAT
							# Enable Temperature Sensors
							register "temp_ctrl1" = "0x2A"			# DTS, VSEN12, VSEN13
							register "temp_ctrl2" = "0x3D"			# TD1, TR2, TR3
							# Enable Fan Sensors
							register "fanin_ctrl1" = "0xFF"			# FANIN1-8
							register "fanin_ctrl2" = "0x00"			# OFF
							# Select Temperature Sources for Fan Control
							register "temp1_source_select" = "0x01"		# Temperature1 = DTS1 (Socket1)
							register "temp2_source_select" = "0x01"		# Temperature2 = DTS2 (Socket2)
							register "temp3_source_select" = "0x00"		# Temperature3 = TR3 (Board TR1)
							register "temp4_source_select" = "0x01"		# Temperature4 = DTS4 (not used)
							register "temp5_source_select" = "0x01"		# Temperature5 = TD1 (North Bridge)
							register "temp6_source_select" = "0x01"		# Temperature6 = TR2 (Board TR2)
							# Assign Temperatures to Fan Zones
							register "temp1_fan_select" = "0x03"		# Temperature1 controls Fan1+Fan2
							register "temp2_fan_select" = "0x03"		# Temperature2 controls Fan1+Fan2
							register "temp3_fan_select" = "0x00"		# Temperature3 controls nothing
							register "temp4_fan_select" = "0x00"		# Temperature4 controls nothing
							register "temp5_fan_select" = "0x03"		# Temperature5 controls Fan1+Fan2
							register "temp6_fan_select" = "0x00"		# Temperature6 controls nothing
							# Target Temperatures (C), ThermalCruise Mode
							register "temp1_target_temperature" = "40"	# Socket1
							register "temp2_target_temperature" = "40"	# Socket2
							register "temp3_target_temperature" = "40"
							register "temp4_target_temperature" = "40"
							register "temp5_target_temperature" = "60"	# North Bridge
							register "temp6_target_temperature" = "40"
							# Target Hysteresis Values (+/- C), ThermalCruise and SmartFan Modes
							register "temp1_target_hysteresis" = "1"
							register "temp2_target_hysteresis" = "1"
							register "temp3_target_hysteresis" = "1"
							register "temp4_target_hysteresis" = "1"
							register "temp5_target_hysteresis" = "1"
							register "temp6_target_hysteresis" = "1"
							# Critical Temperatures (C) to Full Speed Fans, ThermalCruise and SmartFan Modes
							register "temp1_critical_temperature" = "62"	# Socket 1
							register "temp2_critical_temperature" = "62"	# Socket 2
							register "temp3_critical_temperature" = "62"
							register "temp4_critical_temperature" = "62"
							register "temp5_critical_temperature" = "82"	# North Bridge
							register "temp6_critical_temperature" = "62"
							# Critical Hysteresis Values (+/- C) to stop Full speeding fans, ThermalCruise and SmartFan Modes
							register "temp1_critical_hysteresis" = "10"
							register "temp2_critical_hysteresis" = "10"
							register "temp3_critical_hysteresis" = "10"
							register "temp4_critical_hysteresis" = "10"
							register "temp5_critical_hysteresis" = "10"
							register "temp6_critical_hysteresis" = "10"
							# Minimum Fan speeds (%), ThermalCruise and SmartFan Modes
							register "fan1_nonstop" = "14"
							register "fan2_nonstop" = "14"
							register "fan3_nonstop" = "14"
							register "fan4_nonstop" = "14"
							register "fan5_nonstop" = "14"
							register "fan6_nonstop" = "14"
							register "fan7_nonstop" = "14"
							register "fan8_nonstop" = "14"
							# Time delays to step up/down fan speeds (deciseconds), ThermalCruise and SmartFan Modes
							register "step_up_time" = "5"
							register "step_down_time" = "10"
							# Power on speed of fans (%)
							register "poweron_speed" = "75"
							# Fan speeds (%)
							register "fan1_duty" = "100"
							register "fan2_duty" = "100"
							register "fan3_duty" = "100"
							register "fan4_duty" = "100"
							register "fan5_duty" = "100"
							register "fan6_duty" = "100"
							register "fan7_duty" = "100"
							register "fan8_duty" = "100"
							# SmartFan Control Curve
							register "sfiv_table[0].temperatures" = "{ 30, 35, 40, 45, 50, 55, 60 }"	# Socket 1
							register "sfiv_table[1].temperatures" = "{ 30, 35, 40, 45, 50, 55, 60 }"	# Socket 1
							register "sfiv_table[2].temperatures" = "{ 30, 35, 40, 45, 50, 55, 60 }"
							register "sfiv_table[3].temperatures" = "{ 30, 35, 40, 45, 50, 55, 60 }"
							register "sfiv_table[4].temperatures" = "{ 40, 45, 60, 65, 70, 75, 80 }"	# North Bridge
							register "sfiv_table[5].temperatures" = "{ 30, 35, 40, 45, 50, 55, 60 }"
							register "sfiv_table[0].fan_percents" = "{ 15, 15, 20, 30, 40, 50, 100 }"	# Socket 1
							register "sfiv_table[1].fan_percents" = "{ 15, 15, 20, 30, 40, 50, 100 }"	# Socket 1
							register "sfiv_table[2].fan_percents" = "{ 15, 15, 20, 30, 40, 50, 100 }"
							register "sfiv_table[3].fan_percents" = "{ 15, 15, 20, 30, 40, 50, 100 }"
							register "sfiv_table[4].fan_percents" = "{ 15, 15, 20, 30, 40, 50, 100 }"	# North Bridge
							register "sfiv_table[5].fan_percents" = "{ 15, 15, 20, 30, 40, 50, 100 }"
							# Fan Control Mode, 0:Manual, 1:SpeedCruise (not implemented), 2:ThermalCruise, 3:SmartFan (recommended)
							register "fan_mode" = "3"
							# Temperature Alarms, could be used to trigger SMI#
							register "tr1_critical_temperature" = "84"	# TD1, North Bridge
							register "tr2_critical_temperature" = "64"
							register "tr3_critical_temperature" = "64"
							register "tr4_critical_temperature" = "64"
							register "tr5_critical_temperature" = "64"
							register "tr6_critical_temperature" = "64"
							register "dts_critical_temperature" = "64"	# CPUs
							register "tr1_critical_hysteresis" = "80"	# TD1, North Bridge
							register "tr2_critical_hysteresis" = "60"
							register "tr3_critical_hysteresis" = "60"
							register "tr4_critical_hysteresis" = "60"
							register "tr5_critical_hysteresis" = "60"
							register "tr6_critical_hysteresis" = "60"
							register "dts_critical_hysteresis" = "60"	# CPUs
							register "tr1_warning_temperature" = "80"	# TD1, North Bridge
							register "tr2_warning_temperature" = "60"
							register "tr3_warning_temperature" = "60"
							register "tr4_warning_temperature" = "60"
							register "tr5_warning_temperature" = "60"
							register "tr6_warning_temperature" = "60"
							register "dts_warning_temperature" = "60"	# CPUs
							register "tr1_warning_hysteresis" = "76"	# TD1, North Bridge
							register "tr2_warning_hysteresis" = "56"
							register "tr3_warning_hysteresis" = "56"
							register "tr4_warning_hysteresis" = "56"
							register "tr5_warning_hysteresis" = "56"
							register "tr6_warning_hysteresis" = "56"
							register "dts_warning_hysteresis" = "56"	# CPUs
							# Voltage Alarms, could be used to trigger SMI#
							register "vsen1_high_limit_mv" = "1500"		# Socket 1
							register "vsen1_low_limit_mv" = "900"
							register "vsen2_high_limit_mv" = "1500"		# Socket 2
							register "vsen2_low_limit_mv" = "900"
							register "vsen3_high_limit_mv" = "1600"		# Socket 1, RAM
							register "vsen3_low_limit_mv" = "1100"
							register "vsen4_high_limit_mv" = "1600"		# Socket 2, RAM
							register "vsen4_low_limit_mv" = "1100"
							register "vsen5_high_limit_mv" = "1250"		# Socket 1, HT
							register "vsen5_low_limit_mv" = "1150"
							register "vsen6_high_limit_mv" = "1250"		# Socket 2, HT
							register "vsen6_low_limit_mv" = "1150"
							register "vsen7_high_limit_mv" = "1250"		# North Bridge
							register "vsen7_low_limit_mv" = "1050"
							register "vsen8_high_limit_mv" = "1900"		# +1.8V
							register "vsen8_low_limit_mv" = "1700"
							register "vsen9_high_limit_mv" = "1250"		# +1.2V
							register "vsen9_low_limit_mv" = "1150"
							register "vsen10_high_limit_mv" = "1150"	# +1.1V
							register "vsen10_low_limit_mv" = "1050"
							register "vsen11_high_limit_mv" = "1625"	# 5VSB, scaling factor ~3.2
							register "vsen11_low_limit_mv" = "1500"
							register "vsen12_high_limit_mv" = "1083"	# +12V, scaling factor ~12
							register "vsen12_low_limit_mv" = "917"
							register "vsen13_high_limit_mv" = "1625"	# +5V, scaling factor ~3.2
							register "vsen13_low_limit_mv" = "1500"
							register "vdd_high_limit_mv" = "3500"		# 3VDD
							register "vdd_low_limit_mv" = "3100"
							register "vsb_high_limit_mv" = "3500"		# 3VSB
							register "vsb_low_limit_mv" = "3100"
							register "vbat_high_limit_mv" = "3500"		# VBAT (+3V)
							register "vbat_low_limit_mv" = "2500"
							# SMBUS Location
							register "smbus_aux" = "1"			# Device located on aux SMBUS
							device pnp 5e on end
						end
                                                chip drivers/pc80/tpm
                                                        device pnp 4e.0 on end          # TPM module
                                                end
                                                chip drivers/ipmi               # BMC KCS
                                                        device pnp ca2.0 on end
                                                end
					end
					device pci 14.4 on			# Bridge
						device pci 1.0 on		# Slot
							# Slot			# PCI 0
						end
						device pci 2.0 on		# Slot
							# Slot			# PCI 1
						end
						device pci 3.0 on		# Slot
							# Slot			# PCI 2
						end
						device pci 5.0 on end		# VGA
					end
					device pci 14.5 on end			# USB OHCI2 0x4399
				end
			end
			device pci 18.1 on end
			device pci 18.2 on end
			device pci 18.3 on end
			device pci 18.4 on end
			device pci 18.5 on end
			device pci 19.0 on end		# Socket 1 node 0
			device pci 19.1 on end
			device pci 19.2 on end
			device pci 19.3 on end
			device pci 19.4 on end
			device pci 19.5 on end
		end
	end
end
