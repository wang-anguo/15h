if BOARD_SUPERMICRO_H8QGI_PM_F || BOARD_SUPERMICRO_H8QG6_PM_F

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select AGESA_LEGACY
	select CPU_AMD_AGESA_FAMILY15
	select CPU_AMD_SOCKET_G34
	select NORTHBRIDGE_AMD_AGESA_FAMILY15
	select NORTHBRIDGE_AMD_CIMX_RD890
	select SOUTHBRIDGE_AMD_CIMX_SB700
	select SUPERIO_WINBOND_W83627DHG
	select SUPERIO_NUVOTON_WPCM450
	select DRIVERS_I2C_W83795
	select HAVE_OPTION_TABLE
	select HAVE_PIRQ_TABLE
	select HAVE_MP_TABLE
	select HAVE_ACPI_TABLES
	select BOARD_ROMSIZE_KB_2048

config MAINBOARD_DIR
	string
	default supermicro/h8qgi

config VARIANT_DIR
	string
	default "h8qgi_pm_f" if BOARD_SUPERMICRO_H8QGI_PM_F
	default "h8qg6_pm_f" if BOARD_SUPERMICRO_H8QG6_PM_F

config MAINBOARD_PART_NUMBER
	string
	default "H8QGi+-F" if BOARD_SUPERMICRO_H8QGI_PM_F
	default "H8QG6+-F" if BOARD_SUPERMICRO_H8QG6_PM_F

config DEVICETREE
	string
	default "variants/$(CONFIG_VARIANT_DIR)/devicetree.cb"

config HW_MEM_HOLE_SIZEK
	hex
	default 0x200000

config MAX_CPUS
	int
	default 64

config IRQ_SLOT_COUNT
	int
	default 11

config ONBOARD_VGA_IS_PRIMARY
	bool
	default y

config VGA_BIOS
	bool
	default y

config VGA_BIOS_ID
	string
	depends on VGA_BIOS
	default "102b,0532"

config VGA_BIOS_FILE
	string
	default "3rdparty/blobs/mainboard/supermicro/h8qgi/VGABIOS.bin"

endif # BOARD_SUPERMICRO_H8QGI
