config NORTHBRIDGE_AMD_CIMX_RD890
	bool
	default n
	select AMD_NB_CIMX

if NORTHBRIDGE_AMD_CIMX_RD890

config ENABLE_NB_CIMX_DEBUGGER
	bool "Enable CIMx Debugging"
	default n
	help
	  This option enables the AMD CIMX debugger and redirects it to the coreboot console.

	  Warning: Only enable this option when debuging or tracing AMD CIMX code.

config NORTHBRIDGE_AMD_CIMX_RD890_IOMMU
	bool "Enable IOMMU"
	default y

endif # NORTHBRIDGE_AMD_CIMX_RD890
